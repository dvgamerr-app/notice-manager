{
  "name": "notice-manager",
  "version": "7.0.0",
  "packageManager": "bun@1.3.14",
  "description": "Multi-bot LINE Messaging API management console for LIFF.",
  "private": true,
  "keywords": [],
  "author": "Kananek T.",
  "license": "MIT",
  "scripts": {
    "start": "bun index.js",
    "dev": "NODE_ENV=development bun --watch index.js",
    "ui": "vite --config liff/vite.config.js",
    "build:ui": "vite build --config liff/vite.config.js",
    "preview:ui": "vite preview --config liff/vite.config.js",
    "migrate": "bun scripts/migrate.js",
    "test": "bun test",
    "typecheck": "bun x tsc -p jsconfig.json",
    "check": "bun run typecheck && bun test && bun run build:ui"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "elysia": "^1.4.29",
    "kysely": "^0.29.5",
    "lucide-react": "^1.31.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@line/liff": "^2.29.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.21.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvgamerr-app/notice-manager.git"
  },
  "bugs": {
    "url": "https://github.com/dvgamerr-app/notice-manager/issues"
  },
  "homepage": "https://github.com/dvgamerr-app/notice-manager#readme",
  "directories": {
    "doc": "docs"
  },
  "module": "index.js",
  "type": "module",
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
