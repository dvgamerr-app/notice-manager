{
  "name": "notice-manager",
  "version": "7.1.0",
  "packageManager": "bun@1.3.14",
  "description": "Multi-bot LINE Messaging API management console for LIFF.",
  "private": true,
  "overrides": {
    "nanoid": "3.3.18"
  },
  "keywords": [],
  "author": "Kananek T.",
  "license": "MIT",
  "scripts": {
    "start": "bun index.js",
    "dev": "bun --watch index.js",
    "dev:ui": "vite --config vite.config.js",
    "build:ui": "vite build --config vite.config.js",
    "preview:ui": "vite preview --config vite.config.js",
    "verify:build": "bun scripts/verify-build.js",
    "smoke:dev": "bun scripts/smoke-development.js",
    "smoke:prod": "bun scripts/smoke-production.js",
    "migrate": "bun scripts/migrate.js",
    "retention": "bun scripts/retention.js",
    "test": "bun test",
    "typecheck": "bun x tsc -p jsconfig.json",
    "check": "bun run typecheck && bun test && bun run build:ui && bun run verify:build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "file-type": "^22.1.1",
    "kysely": "^0.29.6",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@line/liff": "^2.31.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/whatwg-fetch": "^0.0.33",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvgamerr-app/notice-manager.git"
  },
  "bugs": {
    "url": "https://github.com/dvgamerr-app/notice-manager/issues"
  },
  "homepage": "https://github.com/dvgamerr-app/notice-manager#readme",
  "directories": {
    "doc": "docs"
  },
  "module": "index.js",
  "type": "module"
}
