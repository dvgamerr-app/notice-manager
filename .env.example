# ---------------------------------------------------------------------------
# Quick start (Docker): only these three values are required.
# ---------------------------------------------------------------------------
# LIFF ID of your LINE Login channel, e.g. 1234567890-AbCdEfGh. The LINE Login
# channel ID is derived from it, so LINE_LOGIN_CHANNEL_ID is optional.
LIFF_ID=
# Public HTTPS URL of this server (LIFF endpoint is ${PUBLIC_BASE_URL}/liff/).
PUBLIC_BASE_URL=https://line.example.com
# 32+ random characters: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# Only for `docker compose --profile https up -d` (automatic HTTPS via Caddy).
# DOMAIN=line.example.com

# ---------------------------------------------------------------------------
# Optional / advanced
# ---------------------------------------------------------------------------
# Server
PORT=3000
# BASE_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:5173
# Pino level: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
# json (default, one JSON record per line) or text (pino-pretty, for terminals).
LOG_FORMAT=json
# Database. Default: SQLite (in the Docker volume, or ./notice-manager.sqlite locally).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_manager
# DATABASE_URL=sqlite://./notice-manager.sqlite

# LINE Login channel that owns the LIFF app
# Optional when LIFF_ID is set.
LINE_LOGIN_CHANNEL_ID=
# Optional build-time fallback; prefer LIFF_ID (runtime).
VITE_LIFF_ID=
VITE_API_URL=

# Optional explicit allowlist. When empty, the first verified LIFF user becomes
# the permanent owner stored in app_setting.owner_line_user_id.
LINE_ADMIN_USER_IDS=
SESSION_DAYS=30
EXTERNAL_API_RATE_LIMIT=60
# Data retention in days. Set an individual value to 0 to disable that cleanup.
RETENTION_WEBHOOK_EVENTS_DAYS=30
RETENTION_FORWARDS_DAYS=30
RETENTION_DELIVERIES_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_EXPIRED_SESSIONS_DAYS=7
RETENTION_RATE_LIMIT_BUCKETS_DAYS=2
RETENTION_BATCH_SIZE=1000

# Local development only. Never enable these in production.
DEV_AUTH_BYPASS=false
VITE_DEV_AUTH_BYPASS=false
